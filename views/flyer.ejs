<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Flyer Generator', page: 'flyer' }) %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<body class="body-centered">

    <div class="container" style="max-width: 900px;">
        <%- include('partials/nav', { page: 'flyer' }) %>
        
        <h1>Flyer Generator</h1>
        
        <div class="flyer-controls">
            <input type="text" id="custom-title" value="" placeholder="Enter Title..." oninput="updateTitle()">
            
            <select id="timezone-select" onchange="initFlyer()" class="btn btn-small btn-secondary" style="background: #151e29; border: 1px solid #444; color: white;">
                <option value="AUTO" selected>Auto-detect Local Time</option>
                <option value="Europe/London">UK / London (BST/GMT)</option>
                <option value="America/New_York">US Eastern (EST/EDT)</option>
                <option value="America/Chicago">US Central (CST/CDT)</option>
                <option value="America/Denver">US Mountain (MST/MDT)</option>
                <option value="America/Los_Angeles">US Pacific (PST/PDT)</option>
                <option value="Europe/Berlin">Central Europe (CET/CEST)</option>
                <option value="Asia/Tokyo">Japan (JST)</option>
                <option value="Australia/Sydney">Australia Eastern (AEST/AEDT)</option>
                <option value="UTC">UTC (Default)</option>
            </select>
            
            <button onclick="initFlyer()" class="btn btn-small">🔄 Refresh Data</button>
            <button onclick="downloadFlyer()" class="btn btn-small btn-secondary">⬇️ Download PNG</button>
        </div>

        <div id="flyer-canvas">
            
            <div class="flyer-header-area">
                <h2 id="flyer-date">LOADING...</h2>
                <h3 id="flyer-subtitle"></h3>
            </div>

            <div id="flyer-box">
                <div id="flyer-lines">
                    </div>
            </div>

            <div class="flyer-footer-area">
                <div class="footer-logos">
                    <img src="/cdn/logos/club/Logo.png" class="footer-icon">
                </div>
                <span class="footer-url">clubfurn.com</span>
            </div>

        </div>
    </div>

    <script src="/cdn/js/theme-engine.js"></script>
    <script src="/cdn/js/flyer.js"></script>
    
    <script>
        function updateTitle() {
            const input = document.getElementById('custom-title');
            const display = document.getElementById('flyer-subtitle');
            display.innerText = input.value.toUpperCase();
        }
    </script>
</body>
</html>
