<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Club FuRN Overlay</title>
    <link rel="stylesheet" href="/cdn/css/overlay.css">
</head>
<body>
    <div id="overlay-container">
        <!-- Top Left: Population Pulse -->
        <div id="population-pulse" class="overlay-element top-left">
            <div class="content-box glass">
                <div class="label">INSTANCE POPULATION</div>
                <div class="value"><span id="vrc-count">0</span><span class="total">/</span><span id="vrc-capacity">0</span></div>
                <div class="status-indicator" id="vrc-active-dot"></div>
            </div>
        </div>

        <!-- Bottom Left: Now Playing -->
        <div id="now-playing" class="overlay-element bottom-left slide-out-left">
            <div class="content-box glass">
                <div class="performer-info">
                    <div id="current-dj-avatar-wrapper"></div>
                    <div class="details">
                        <div class="label" id="current-label-container">NOW PLAYING <span id="current-countdown" class="set-countdown"></span></div>
                        <div id="current-dj-name" class="name">Waiting...</div>
                        <div id="current-genre" class="genre">Electronic</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Right: Up Next -->
        <div id="up-next" class="overlay-element bottom-right slide-out-right">
            <div class="content-box glass">
                <div class="label">UP NEXT</div>
                <div id="next-performers-list">
                    <!-- Dynamic Items -->
                </div>
            </div>
        </div>
    </div>

    <script src="/cdn/js/overlay.js"></script>
</body>
</html>
