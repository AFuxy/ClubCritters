<%- include('header') %>

<div class="staff-hub" style="display: flex; flex-direction: column; align-items: center; gap: 20px;">
    
    <!-- Top Header -->
    <div class="staff-section" style="max-width: 900px; width: 100%; text-align: center; border: 1px solid var(--primary-purple); padding: 30px; margin-bottom: 0;">
        <h1 style="color: var(--primary-purple); border: none; margin-bottom: 10px;">Kit Mascot Access</h1>
        <p style="color: #888; margin-bottom: 0;">Authorized performers can use this account and control the camera bot for official Club FuRN events.</p>
    </div>

    <!-- Main Grid -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; max-width: 900px; width: 100%; box-sizing: border-box;">
        
        <!-- COLUMN 1: CREDENTIALS & BOT LAUNCH / OBS CONTROL -->
        <div style="display: flex; flex-direction: column; gap: 20px;">
            
            <!-- Credentials Block -->
            <div style="background: var(--card-bg); border: 1px solid rgba(255,255,255,0.05); padding: 25px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
                <h2 style="color: var(--primary-blue); font-size: 1.1rem; margin-top: 0; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; text-transform: uppercase; letter-spacing: 1px;">VRChat Credentials</h2>
                
                <div class="form-group">
                    <label style="color:#aaa; font-size:0.8rem; font-weight:bold; text-transform:uppercase; margin-bottom:5px; display:block;">Username / Email</label>
                    <div style="display: flex; gap: 10px;">
                        <input type="text" value="<%= mascotEmail %>" readonly style="flex: 1; background: rgba(0,0,0,0.5); border: 1px solid #444; color: #fff; border-radius: 8px; padding: 10px; font-family: inherit;">
                        <button class="btn-cc btn-small btn-dark" onclick="copyToClipboard('<%= mascotEmail %>')">📋 Copy</button>
                    </div>
                </div>
                
                <div class="form-group" style="margin-top: 15px;">
                    <label style="color:#aaa; font-size:0.8rem; font-weight:bold; text-transform:uppercase; margin-bottom:5px; display:block;">Password</label>
                    <div style="display: flex; gap: 10px;">
                        <input type="password" id="vrc-pass" value="<%= mascotPassword %>" readonly style="flex: 1; background: rgba(0,0,0,0.5); border: 1px solid #444; color: #fff; border-radius: 8px; padding: 10px; font-family: inherit;">
                        <button class="btn-cc btn-small btn-dark" onclick="togglePass()">👁️ Show</button>
                        <button class="btn-cc btn-small btn-dark" onclick="copyToClipboard('<%= mascotPassword %>')">📋 Copy</button>
                    </div>
                </div>
            </div>

            <!-- Bot Connection & Launch Controls -->
            <div style="background: var(--card-bg); border: 1px solid rgba(255,255,255,0.05); padding: 25px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
                <h2 style="color: var(--primary-purple); font-size: 1.1rem; margin-top: 0; margin-bottom: 15px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; justify-content: space-between;">
                    Camera Bot PC 
                    <span id="bot-status-badge" class="badge" style="background: #ff4444; font-size: 0.65rem; padding: 4px 10px; border-radius: 20px; color: white; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">Offline</span>
                </h2>
                
                <!-- Current Location Block -->
                <div style="background: rgba(0,0,0,0.3); padding: 15px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.02); margin-bottom: 15px; display: flex; gap: 15px; align-items: center;">
                    <img id="vrc-world-icon" src="" style="width: 80px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid rgba(255,255,255,0.1); display: none;">
                    <div style="flex: 1;">
                        <span style="color: #aaa; font-size: 0.75rem; font-weight: bold; text-transform: uppercase; display: block; margin-bottom: 2px;">VRChat Instance</span>
                        <span id="vrc-location-text" style="font-weight: 800; color: #888; font-size: 0.95rem; line-height: 1.3;">OFFLINE</span>
                        <span id="vrc-player-count-text" style="color: #666; font-size: 0.75rem; display: block; margin-top: 2px; font-weight: 600; text-transform: uppercase;">0 PLAYERS INSIDE</span>
                    </div>
                </div>
                
                <div class="form-group">
                    <label style="color:#aaa; font-size:0.8rem; font-weight:bold; text-transform:uppercase; margin-bottom:5px; display:block;">VRChat Instance Link</label>
                    <input type="text" id="vrc-instance-url" placeholder="https://vrchat.com/home/launch?worldId=..." style="width: 100%; background: rgba(0,0,0,0.5); border: 1px solid #444; color: #fff; border-radius: 8px; padding: 10px; margin-bottom: 15px; box-sizing: border-box;">
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <!-- VRChat Launch/Close -->
                    <button class="btn-cc btn-secondary btn-small" id="btn-launch-vrc" onclick="sendCommand('launch_vrc', document.getElementById('vrc-instance-url').value)">🚀 Launch VRC</button>
                    <button class="btn-cc btn-dark btn-small" style="background: rgba(255, 68, 68, 0.1); border-color: rgba(255, 68, 68, 0.3); color: #ff4444; display: none;" id="btn-kill-vrc" onclick="sendCommand('kill_vrc')" disabled>🛑 Close VRC</button>

                    <!-- OBS Launch/Close -->
                    <button class="btn-cc btn-secondary btn-small" id="btn-launch-obs" onclick="sendCommand('launch_obs')">🎥 Launch OBS</button>
                    <button class="btn-cc btn-dark btn-small" style="background: rgba(255, 68, 68, 0.1); border-color: rgba(255, 68, 68, 0.3); color: #ff4444; display: none;" id="btn-kill-obs" onclick="sendCommand('kill_obs')" disabled>🛑 Close OBS</button>
                </div>
            </div>

            <!-- OBS Controls -->
            <div style="background: var(--card-bg); border: 1px solid rgba(255,255,255,0.05); padding: 25px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);">
                <h2 style="color: var(--primary-pink); font-size: 1.1rem; margin-top: 0; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; text-transform: uppercase; letter-spacing: 1px;">OBS Output Control</h2>
                
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px; background: rgba(0,0,0,0.3); padding: 12px 15px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.02);">
                    <span style="font-size: 0.9rem; color: #aaa; font-weight: 600;">Status:</span>
                    <span id="obs-status-text" style="font-weight: 900; color: #888; letter-spacing: 0.5px;">DISCONNECTED</span>
                </div>

                <!-- Scene Selector Dropdown -->
                <div class="form-group" style="margin-bottom: 15px;">
                    <label style="color:#aaa; font-size:0.8rem; font-weight:bold; text-transform:uppercase; margin-bottom:5px; display:block;">Active Scene</label>
                    <select id="obs-scene-select" onchange="sendCommand('change_scene', this.value)" style="width: 100%; background: rgba(0,0,0,0.5); border: 1px solid #444; color: #fff; border-radius: 8px; padding: 10px; font-family: inherit; font-size: 0.9rem;" disabled>
                        <option value="">No scenes available</option>
                    </select>
                </div>

                <!-- Output Actions -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px;">
                    <button class="btn-cc btn-primary btn-small" id="btn-obs-stream" onclick="sendCommand('toggle_stream')" disabled>Start Stream</button>
                    <button class="btn-cc btn-primary btn-small" id="btn-obs-record" onclick="sendCommand('toggle_record')" disabled>Start Record</button>
                </div>

                <!-- Live Stream Statistics Grid -->
                <div id="obs-stats-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; background: rgba(0,0,0,0.2); padding: 15px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.02); font-size: 0.8rem; line-height: 1.6;">
                    <div><span style="color:#666; font-weight:bold; text-transform:uppercase; font-size:0.7rem; display:block;">Duration</span> <span id="obs-stat-duration" style="color:#ddd; font-weight:700;">00:00:00</span></div>
                    <div><span style="color:#666; font-weight:bold; text-transform:uppercase; font-size:0.7rem; display:block;">FPS</span> <span id="obs-stat-fps" style="color:#ddd; font-weight:700;">0.00</span></div>
                    <div><span style="color:#666; font-weight:bold; text-transform:uppercase; font-size:0.7rem; display:block;">Bitrate</span> <span id="obs-stat-bitrate" style="color:#ddd; font-weight:700;">0 kbps</span></div>
                    <div><span style="color:#666; font-weight:bold; text-transform:uppercase; font-size:0.7rem; display:block;">CPU Usage</span> <span id="obs-stat-cpu" style="color:#ddd; font-weight:700;">0.0%</span></div>
                    <div style="grid-column: span 2;"><span style="color:#666; font-weight:bold; text-transform:uppercase; font-size:0.7rem; display:block;">Dropped Frames</span> <span id="obs-stat-dropped" style="color:#ddd; font-weight:700;">0 / 0 (0.0%)</span></div>
                </div>
            </div>

        </div>

        <!-- COLUMN 2: WASD CONTROLLER & LOOK CONTROLS -->
        <div style="display: flex; flex-direction: column; gap: 20px;">
            
            <!-- Virtual WASD D-Pad (Camera Movement) -->
            <div style="background: var(--card-bg); border: 1px solid rgba(255,255,255,0.05); padding: 25px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.2); display: flex; flex-direction: column; align-items: center;">
                <h2 style="color: var(--primary-blue); font-size: 1.1rem; margin-top: 0; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; text-transform: uppercase; letter-spacing: 1px; width: 100%; text-align: left;">Camera Movement</h2>
                
                <div style="display: grid; grid-template-columns: 60px 60px 60px; grid-template-rows: 60px 60px; gap: 12px; margin-bottom: 20px; margin-top: 10px;">
                    <div></div>
                    <button id="key-w" class="btn-cc btn-dark dpad-btn" style="width:60px; height:60px; border-radius:12px; font-weight:800; font-size:1.2rem; padding:0; line-height: 60px;" onmousedown="sendMovementKey('w', 'down')" onmouseup="sendMovementKey('w', 'up')" onmouseleave="sendMovementKey('w', 'up')">W</button>
                    <div></div>
                    
                    <button id="key-a" class="btn-cc btn-dark dpad-btn" style="width:60px; height:60px; border-radius:12px; font-weight:800; font-size:1.2rem; padding:0; line-height: 60px;" onmousedown="sendMovementKey('a', 'down')" onmouseup="sendMovementKey('a', 'up')" onmouseleave="sendMovementKey('a', 'up')">A</button>
                    <button id="key-s" class="btn-cc btn-dark dpad-btn" style="width:60px; height:60px; border-radius:12px; font-weight:800; font-size:1.2rem; padding:0; line-height: 60px;" onmousedown="sendMovementKey('s', 'down')" onmouseup="sendMovementKey('s', 'up')" onmouseleave="sendMovementKey('s', 'up')">S</button>
                    <button id="key-d" class="btn-cc btn-dark dpad-btn" style="width:60px; height:60px; border-radius:12px; font-weight:800; font-size:1.2rem; padding:0; line-height: 60px;" onmousedown="sendMovementKey('d', 'down')" onmouseup="sendMovementKey('d', 'up')" onmouseleave="sendMovementKey('d', 'up')">D</button>
                </div>
                <p style="color:#555; font-size:0.75rem; font-weight:bold; text-transform:uppercase; letter-spacing:1px; margin:0;">Use Keyboard WASD keys</p>
            </div>

            <!-- Virtual Look D-Pad (Camera Look & Click) -->
            <div style="background: var(--card-bg); border: 1px solid rgba(255,255,255,0.05); padding: 25px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.2); display: flex; flex-direction: column; align-items: center;">
                <h2 style="color: var(--primary-pink); font-size: 1.1rem; margin-top: 0; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; text-transform: uppercase; letter-spacing: 1px; width: 100%; text-align: left;">Camera Look & Interact</h2>
                
                <div style="display: grid; grid-template-columns: 60px 60px 60px; grid-template-rows: 60px 60px 60px; gap: 12px; margin-bottom: 20px; margin-top: 10px;">
                    <div></div>
                    <button id="look-up-btn" class="btn-cc btn-dark dpad-btn" style="width:60px; height:60px; border-radius:12px; font-weight:800; font-size:1.1rem; padding:0; line-height: 60px;" onmousedown="startMouseLook(0, -5)" onmouseup="stopMouseLook()" onmouseleave="stopMouseLook()">▲</button>
                    <div></div>
                    
                    <button id="key-left" class="btn-cc btn-dark dpad-btn" style="width:60px; height:60px; border-radius:12px; font-weight:800; font-size:1.1rem; padding:0; line-height: 60px;" onmousedown="startMouseLook(-10, 0)" onmouseup="stopMouseLook()" onmouseleave="stopMouseLook()">◀</button>
                    <button id="interact-btn" class="btn-cc btn-primary" style="width:60px; height:60px; border-radius:12px; font-weight:800; font-size:0.85rem; padding:0; line-height: 60px; background: var(--primary-gradient);" onclick="sendMouseClick()">Click</button>
                    <button id="key-right" class="btn-cc btn-dark dpad-btn" style="width:60px; height:60px; border-radius:12px; font-weight:800; font-size:1.1rem; padding:0; line-height: 60px;" onmousedown="startMouseLook(10, 0)" onmouseup="stopMouseLook()" onmouseleave="stopMouseLook()">▶</button>
                    
                    <div></div>
                    <button id="look-down-btn" class="btn-cc btn-dark dpad-btn" style="width:60px; height:60px; border-radius:12px; font-weight:800; font-size:1.1rem; padding:0; line-height: 60px;" onmousedown="startMouseLook(0, 5)" onmouseup="stopMouseLook()" onmouseleave="stopMouseLook()">▼</button>
                    <div></div>
                </div>
                <p style="color:#555; font-size:0.75rem; font-weight:bold; text-transform:uppercase; letter-spacing:1px; margin:0;">Use Keyboard Arrow keys to Turn</p>
            </div>

            <!-- In-Instance Roster -->
            <div style="background: var(--card-bg); border: 1px solid rgba(255,255,255,0.05); padding: 25px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.2); flex-grow: 1; display: flex; flex-direction: column;">
                <h2 style="color: var(--primary-purple); font-size: 1.1rem; margin-top: 0; margin-bottom: 15px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 10px; text-transform: uppercase; letter-spacing: 1px;">Players In-Instance</h2>
                
                <div id="roster-list-container" style="flex-grow: 1; background: rgba(0,0,0,0.2); border-radius: 8px; padding: 15px; min-height: 150px; overflow-y: auto;">
                    <p style="color:#555; text-align:center; margin-top: 40px; font-style:italic;" id="roster-empty-text">No active players tracked.</p>
                    <ul id="roster-ul" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;"></ul>
                </div>
            </div>

        </div>

    </div>

    <!-- Security Guidelines -->
    <div class="staff-section" style="max-width: 900px; width: 100%; background: rgba(255, 68, 68, 0.05); border: 1px solid rgba(255, 68, 68, 0.2); text-align: left; padding: 25px; border-radius: 16px; margin-bottom: 20px;">
        <h3 style="color: var(--accent-red); margin-top: 0; font-size: 1rem; text-transform: uppercase; letter-spacing: 1px;">⚠️ Security Guidelines</h3>
        <ul style="color: #ccc; font-size: 0.85rem; line-height: 1.6; padding-left: 20px; margin-bottom: 0;">
            <li>Never share these credentials outside of the authorized performer team.</li>
            <li>Do not change the account password, email, or security settings.</li>
            <li>Ensure you log out of the account after your performance is finished.</li>
            <li>Use the movement controls responsibly to avoid disrupting the stream or event.</li>
        </ul>
    </div>

</div>

<!-- Styles for controller highlights -->
<style>
    .dpad-btn {
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);
        transition: all 0.1s ease !important;
        cursor: pointer;
    }
    .dpad-btn.active-press {
        background: var(--primary-gradient) !important;
        color: white !important;
        border-color: transparent !important;
        box-shadow: 0 0 15px var(--primary-blue) !important;
        transform: scale(0.95);
    }
    #roster-ul li {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255,255,255,0.05);
        padding: 10px 15px;
        border-radius: 8px;
        color: #ddd;
        font-weight: 600;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    @keyframes pulse {
        0% { opacity: 0.6; }
        50% { opacity: 1; }
        100% { opacity: 0.6; }
    }
    .pulsing-text {
        animation: pulse 1.5s infinite ease-in-out;
    }
</style>

<script>
    function togglePass() {
        const pass = document.getElementById('vrc-pass');
        const btn = event.target;
        if (pass.type === 'password') {
            pass.type = 'text';
            btn.innerText = '🔒 Hide';
        } else {
            pass.type = 'password';
            btn.innerText = '👁️ Show';
        }
    }

    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(() => {
            showNotify('Copied to clipboard!');
        });
    }

    // --- WEBSOCKET CLIENT CONNECTIVITY ---
    let ws = null;
    let currentWsToken = "<%= cameraWsToken %>";
    let botConnected = false;

    async function getNewToken() {
        try {
            const res = await fetch('/panel/camera-token');
            if (res.ok) {
                const data = await res.json();
                return data.token;
            }
        } catch (e) {
            console.error("Failed to fetch fresh ws token", e);
        }
        return null;
    }

    async function connectWS() {
        if (!currentWsToken) {
            currentWsToken = await getNewToken();
        }
        if (!currentWsToken) {
            setTimeout(connectWS, 5000);
            return;
        }

        const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        ws = new WebSocket(`${protocol}//${window.location.host}/ws/camera?token=${currentWsToken}`);

        ws.onopen = () => {
            console.log("[CAMERA WS] Connected to relay server.");
        };

        ws.onmessage = (event) => {
            try {
                const msg = JSON.parse(event.data);
                
                // Status Update
                if (msg.type === 'status') {
                    updateStatus(msg.botOnline);
                    if (msg.players) updateRoster(msg.players);
                    if (msg.vrc_running !== undefined && msg.obs_running !== undefined) {
                        updateAppsState(msg.vrc_running, msg.obs_running);
                    }
                    if (msg.vrc_world_name) {
                        updateVrcLocation(msg.vrc_world_name, msg.vrc_world_thumbnail, msg.vrc_player_count);
                    }
                } 
                // Telemetry / Player list Updates
                else if (msg.type === 'telemetry') {
                    if (msg.players) updateRoster(msg.players);
                    if (msg.obs) updateOBSUI(msg.obs);
                    if (msg.vrc_running !== undefined && msg.obs_running !== undefined) {
                        updateAppsState(msg.vrc_running, msg.obs_running);
                    }
                    if (msg.vrc_world_name) {
                        updateVrcLocation(msg.vrc_world_name, msg.vrc_world_thumbnail, msg.vrc_player_count);
                    }
                }
            } catch (err) {
                console.error("[CAMERA WS] Message error:", err);
            }
        };

        ws.onclose = () => {
            console.warn("[CAMERA WS] Connection closed. Reconnecting...");
            updateStatus(false);
            currentWsToken = null; // Single-use tokens require fetching a fresh one
            setTimeout(connectWS, 5000);
        };
    }

    function updateStatus(botOnline) {
        botConnected = botOnline;
        const badge = document.getElementById('bot-status-badge');
        const btnLaunchVrc = document.getElementById('btn-launch-vrc');
        const btnLaunchObs = document.getElementById('btn-launch-obs');
        const btnKillVrc = document.getElementById('btn-kill-vrc');
        const btnKillObs = document.getElementById('btn-kill-obs');
        const btnObsStream = document.getElementById('btn-obs-stream');
        const btnObsRecord = document.getElementById('btn-obs-record');
        const sceneSelect = document.getElementById('obs-scene-select');

        if (botOnline) {
            badge.innerText = 'Online';
            badge.style.background = '#00e676';
            btnLaunchVrc.disabled = false;
            btnLaunchObs.disabled = false;
            btnKillVrc.disabled = false;
            btnKillObs.disabled = false;
            // Let the OBS telemetry payload handle enabling output controls
        } else {
            badge.innerText = 'Offline';
            badge.style.background = '#ff4444';
            btnLaunchVrc.disabled = true;
            btnLaunchObs.disabled = true;
            btnKillVrc.disabled = true;
            btnKillObs.disabled = true;

            // Reset visibilities when offline
            btnLaunchVrc.style.display = 'block';
            btnKillVrc.style.display = 'none';
            btnLaunchObs.style.display = 'block';
            btnKillObs.style.display = 'none';

            btnObsStream.disabled = true;
            btnObsRecord.disabled = true;
            sceneSelect.disabled = true;
            sceneSelect.innerHTML = '<option value="">No scenes available</option>';
            document.getElementById('obs-status-text').innerText = 'DISCONNECTED';
            document.getElementById('obs-status-text').style.color = '#888';
            document.getElementById('vrc-location-text').innerText = 'OFFLINE';
            document.getElementById('vrc-location-text').style.color = '#888';
            document.getElementById('vrc-location-text').classList.remove('pulsing-text');
            document.getElementById('vrc-world-icon').style.display = 'none';
            document.getElementById('vrc-player-count-text').innerText = '0 PLAYERS INSIDE';
            document.getElementById('vrc-player-count-text').style.color = '#666';
            resetStatsDisplay();
        }
    }

    function updateVrcLocation(locationName, thumbnail, playerCount) {
        const text = document.getElementById('vrc-location-text');
        const img = document.getElementById('vrc-world-icon');
        const count = document.getElementById('vrc-player-count-text');

        text.innerText = locationName.toUpperCase();
        
        if (locationName === 'Offline') {
            text.style.color = '#888';
            text.classList.remove('pulsing-text');
            img.style.display = 'none';
            count.innerText = '0 PLAYERS INSIDE';
            count.style.color = '#666';
        } else if (locationName === 'Private Instance') {
            text.style.color = '#ffb300';
            text.classList.remove('pulsing-text');
            img.style.display = 'none';
            count.innerText = 'PRIVATE';
            count.style.color = '#ffb300';
        } else if (locationName.toUpperCase().startsWith('TRAVELING')) {
            text.style.color = '#ff9800'; // Pulsing orange for travel
            text.classList.add('pulsing-text');
            if (thumbnail) {
                img.src = '/panel/world-image?url=' + encodeURIComponent(thumbnail);
                img.style.display = 'block';
            } else {
                img.style.display = 'none';
            }
            count.innerText = 'CONNECTING...';
            count.style.color = '#ff9800';
        } else {
            text.style.color = '#00e676';
            text.classList.remove('pulsing-text');
            if (thumbnail) {
                img.src = '/panel/world-image?url=' + encodeURIComponent(thumbnail);
                img.style.display = 'block';
            } else {
                img.style.display = 'none';
            }
            count.innerText = `${playerCount} ${playerCount === 1 ? 'PLAYER' : 'PLAYERS'} INSIDE`;
            count.style.color = 'var(--primary-blue)';
        }
    }

    function updateAppsState(vrc_running, obs_running) {
        if (!botConnected) return;

        const btnLaunchVrc = document.getElementById('btn-launch-vrc');
        const btnKillVrc = document.getElementById('btn-kill-vrc');
        const btnLaunchObs = document.getElementById('btn-launch-obs');
        const btnKillObs = document.getElementById('btn-kill-obs');

        if (vrc_running) {
            btnLaunchVrc.style.display = 'none';
            btnKillVrc.style.display = 'block';
        } else {
            btnLaunchVrc.style.display = 'block';
            btnKillVrc.style.display = 'none';
        }

        if (obs_running) {
            btnLaunchObs.style.display = 'none';
            btnKillObs.style.display = 'block';
        } else {
            btnLaunchObs.style.display = 'block';
            btnKillObs.style.display = 'none';
        }
    }

    function resetStatsDisplay() {
        document.getElementById('obs-stat-duration').innerText = '00:00:00';
        document.getElementById('obs-stat-fps').innerText = '0.00';
        document.getElementById('obs-stat-bitrate').innerText = '0 kbps';
        document.getElementById('obs-stat-cpu').innerText = '0.0%';
        document.getElementById('obs-stat-dropped').innerText = '0 / 0 (0.0%)';
        document.getElementById('obs-stat-dropped').style.color = '#ddd';
    }

    function updateRoster(players) {
        const ul = document.getElementById('roster-ul');
        const emptyText = document.getElementById('roster-empty-text');

        if (!players || players.length === 0) {
            ul.innerHTML = '';
            emptyText.style.display = 'block';
            return;
        }

        emptyText.style.display = 'none';
        ul.innerHTML = players.map(p => `<li>${p}</li>`).join('');
    }

    function updateOBSUI(obs) {
        const statusText = document.getElementById('obs-status-text');
        const streamBtn = document.getElementById('btn-obs-stream');
        const recordBtn = document.getElementById('btn-obs-record');
        const sceneSelect = document.getElementById('obs-scene-select');

        const durationText = document.getElementById('obs-stat-duration');
        const fpsText = document.getElementById('obs-stat-fps');
        const bitrateText = document.getElementById('obs-stat-bitrate');
        const cpuText = document.getElementById('obs-stat-cpu');
        const droppedText = document.getElementById('obs-stat-dropped');

        if (!obs || !obs.connected) {
            statusText.innerText = 'OBS DISCONNECTED';
            statusText.style.color = '#888';
            sceneSelect.disabled = true;
            streamBtn.disabled = true;
            recordBtn.disabled = true;
            resetStatsDisplay();
            return;
        }

        sceneSelect.disabled = false;
        streamBtn.disabled = false;
        recordBtn.disabled = false;

        // 1. Streaming status
        if (obs.streaming) {
            statusText.innerText = '🔴 LIVE STREAMING';
            statusText.style.color = '#ff4444';
            streamBtn.innerText = 'Stop Stream';
            streamBtn.style.background = 'linear-gradient(45deg, #ff5252, #ff1744)';
        } else {
            statusText.innerText = 'STANDBY';
            statusText.style.color = '#00e676';
            streamBtn.innerText = 'Start Stream';
            streamBtn.style.background = 'var(--primary-gradient)';
        }

        // 2. Recording status
        if (obs.recording) {
            recordBtn.innerText = 'Stop Record';
            recordBtn.style.background = 'linear-gradient(45deg, #ff5252, #ff1744)';
        } else {
            recordBtn.innerText = 'Start Record';
            recordBtn.style.background = 'var(--primary-gradient)';
        }

        // 3. Populate and select active Scene
        if (obs.scenes && obs.scenes.length > 0) {
            const currentScene = obs.currentScene;
            sceneSelect.innerHTML = obs.scenes.map(s => 
                `<option value="${s}" ${s === currentScene ? 'selected' : ''}>${s}</option>`
            ).join('');
        }

        // 4. Update stats
        if (durationText) durationText.innerText = obs.streamTime || '00:00:00';
        if (fpsText) fpsText.innerText = obs.fps !== undefined ? obs.fps.toFixed(2) : '0.00';
        if (bitrateText) bitrateText.innerText = obs.bytesPerSec !== undefined ? `${Math.round((obs.bytesPerSec * 8) / 1000)} kbps` : '0 kbps';
        if (cpuText) cpuText.innerText = obs.cpu !== undefined ? `${obs.cpu.toFixed(1)}%` : '0.0%';

        if (droppedText) {
            const dropped = obs.droppedFrames || 0;
            const total = obs.totalFrames || 0;
            const pct = total > 0 ? ((dropped / total) * 100).toFixed(2) : '0.00';
            droppedText.innerText = `${dropped} / ${total} (${pct}%)`;

            if (dropped > 0 && (dropped / total) > 0.01) {
                droppedText.style.color = '#ff4444'; // Red flag for frame drops
            } else {
                droppedText.style.color = '#ddd';
            }
        }
    }

    function sendCommand(action, payload = null) {
        if (!ws || ws.readyState !== WebSocket.OPEN || !botConnected) {
            showNotify('Bot client is currently offline.', 'error');
            return;
        }
        ws.send(JSON.stringify({
            type: 'command',
            action: action,
            payload: payload
        }));
        showNotify(`Command sent: ${action}`);
    }

    // --- KEYBOARD & VIRTUAL KEY HANDLING ---
    const activeKeys = new Set();
    const keyMap = {
        'KeyW': 'w',
        'KeyA': 'a',
        'KeyS': 's',
        'KeyD': 'd',
        'ArrowLeft': 'left',
        'ArrowRight': 'right'
    };

    function sendMovementKey(key, state) {
        if (!ws || ws.readyState !== WebSocket.OPEN || !botConnected) return;
        
        ws.send(JSON.stringify({
            type: 'control',
            action: 'key',
            key: key,
            state: state
        }));

        // Highlight virtual key
        const btn = document.getElementById(`key-${key}`);
        if (btn) {
            if (state === 'down') btn.classList.add('active-press');
            else btn.classList.remove('active-press');
        }
    }

    // --- MOUSE LOOK & CLICK FUNCTIONS ---
    let mouseLookInterval = null;

    function startMouseLook(x, y) {
        if (!ws || ws.readyState !== WebSocket.OPEN || !botConnected) return;
        if (mouseLookInterval) clearInterval(mouseLookInterval);
        
        sendMouseMove(x, y);
        mouseLookInterval = setInterval(() => {
            sendMouseMove(x, y);
        }, 50);
    }

    function stopMouseLook() {
        if (mouseLookInterval) {
            clearInterval(mouseLookInterval);
            mouseLookInterval = null;
        }
    }

    function sendMouseMove(x, y) {
        if (!ws || ws.readyState !== WebSocket.OPEN || !botConnected) return;
        ws.send(JSON.stringify({
            type: 'control',
            action: 'mouse_move',
            x: x,
            y: y
        }));
    }

    function sendMouseClick() {
        if (!ws || ws.readyState !== WebSocket.OPEN || !botConnected) {
            showNotify('Bot client is currently offline.', 'error');
            return;
        }
        ws.send(JSON.stringify({
            type: 'control',
            action: 'mouse_click'
        }));
        showNotify('Interaction click sent');
    }

    document.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        const code = e.code;
        const mapped = keyMap[code];
        if (mapped && !activeKeys.has(mapped)) {
            if (document.activeElement.tagName === 'INPUT') return;
            activeKeys.add(mapped);
            if (mapped === 'left') {
                startMouseLook(-10, 0);
            } else if (mapped === 'right') {
                startMouseLook(10, 0);
            } else {
                sendMovementKey(mapped, 'down');
            }
        }
    });

    document.addEventListener('keyup', (e) => {
        const code = e.code;
        const mapped = keyMap[code];
        if (mapped && activeKeys.has(mapped)) {
            activeKeys.delete(mapped);
            if (mapped === 'left' || mapped === 'right') {
                stopMouseLook();
            } else {
                sendMovementKey(mapped, 'up');
            }
        }
    });

    // Start WebSocket
    connectWS();
</script>

<%- include('footer') %>
