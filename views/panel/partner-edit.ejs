<%- include('header') %>

<div class="staff-hub">

    <!-- Top Banner Header -->
    <div class="staff-section" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px; margin-bottom: 20px;">
        <div>
            <h2 style="margin: 0; font-size: 1.5rem;">Partner Club Profile</h2>
            <p style="font-size: 0.8rem; color: #888; margin: 5px 0 0 0;">
                Customize your club's showcase details, custom URL slug, accent color, banner, icon, and community links.
            </p>
        </div>
        <% if (partner && partner.slug) { %>
            <a href="/partner/<%= partner.slug %>" target="_blank" class="btn-cc btn-secondary btn-small" style="text-decoration: none;">
                🌐 View Live Page ↗
            </a>
        <% } %>
    </div>

    <!-- MAIN GRID: Form & Live Preview -->
    <div style="display: grid; grid-template-columns: 1fr 360px; gap: 20px; align-items: start;">
        
        <!-- LEFT: Form Controls & Event Manager -->
        <div style="display: flex; flex-direction: column; gap: 20px;">
            
            <div class="staff-section">
                <h3 style="margin-top: 0; margin-bottom: 20px; font-size: 1.1rem; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 10px;">
                    ⚙️ Club Info & Branding
                </h3>

                <form id="partner-form" onsubmit="handlePartnerSubmit(event)">
                    <% if (partner && partner.id) { %>
                        <input type="hidden" id="partner-id" value="<%= partner.id %>">
                    <% } %>

                    <div class="form-group">
                        <label>Club / Community Name *</label>
                        <input type="text" id="partner-name" value="<%= partner ? partner.name : '' %>" placeholder="e.g. Neon Critters Club" required>
                    </div>

                    <!-- CUSTOM URL SLUG -->
                    <div class="form-group">
                        <label>Custom Showcase URL Slug *</label>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="color: #888; font-size: 0.85rem; font-weight: bold; background: rgba(0,0,0,0.3); padding: 10px 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1);">/partner/</span>
                            <input type="text" id="partner-slug" value="<%= partner ? partner.slug : '' %>" placeholder="my-club-slug" required style="flex: 1;">
                        </div>
                        <p style="font-size: 0.75rem; color: #777; margin-top: 4px;">Only lowercase letters, numbers, and hyphens.</p>
                    </div>

                    <!-- BRAND ACCENT COLOR -->
                    <div class="form-group">
                        <label>Brand Accent Color</label>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <input type="color" id="partner-color" value="<%= (partner && partner.accentColor) ? partner.accentColor : '#f2008d' %>" style="width: 45px; height: 40px; border: none; border-radius: 8px; cursor: pointer; background: transparent;" oninput="document.getElementById('partner-color-hex').value=this.value; updatePreviewColor(this.value)">
                            <input type="text" id="partner-color-hex" value="<%= (partner && partner.accentColor) ? partner.accentColor : '#f2008d' %>" placeholder="#f2008d" style="flex: 1;" oninput="document.getElementById('partner-color').value=this.value; updatePreviewColor(this.value)">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Club Description / Bio</label>
                        <textarea id="partner-description" rows="5" placeholder="Tell the community about your club, genres, event times, and vibe..."><%= partner ? partner.description : '' %></textarea>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px;">
                        <!-- ICON UPLOAD -->
                        <div style="background: rgba(0,0,0,0.2); border: 1px dashed rgba(255,255,255,0.15); border-radius: 10px; padding: 15px; text-align: center;">
                            <label style="font-size: 0.8rem; font-weight: bold; color: var(--primary-blue); display: block; margin-bottom: 10px;">
                                🖼️ Club Logo / Icon
                            </label>
                            <div id="icon-preview-box" style="width: 75px; height: 75px; border-radius: 50%; margin: 0 auto 10px auto; overflow: hidden; background: #111; border: 2px solid <%= (partner && partner.accentColor) ? partner.accentColor : '#f2008d' %>; display: flex; align-items: center; justify-content: center;">
                                <img id="icon-preview" src="<%= (partner && partner.iconUrl) ? partner.iconUrl : '/cdn/logos/club/Logo.png' %>" style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                            <input type="file" id="icon-file-input" accept="image/*" style="display: none;" onchange="uploadMedia('icon')">
                            <button type="button" class="btn-cc btn-small btn-secondary" onclick="document.getElementById('icon-file-input').click()" style="width: 100%;">
                                Upload Icon
                            </button>
                        </div>

                        <!-- BANNER UPLOAD -->
                        <div style="background: rgba(0,0,0,0.2); border: 1px dashed rgba(255,255,255,0.15); border-radius: 10px; padding: 15px; text-align: center;">
                            <label style="font-size: 0.8rem; font-weight: bold; color: var(--primary-pink); display: block; margin-bottom: 10px;">
                                🎨 Header Banner
                            </label>
                            <div id="banner-preview-box" style="width: 100%; height: 75px; border-radius: 6px; margin: 0 auto 10px auto; overflow: hidden; background: #111; border: 1px solid rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center;">
                                <img id="banner-preview" src="<%= (partner && partner.bannerUrl) ? partner.bannerUrl : '/cdn/logos/club/banner_fallback.jpg' %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/cdn/logos/club/Logo.png'">
                            </div>
                            <input type="file" id="banner-file-input" accept="image/*" style="display: none;" onchange="uploadMedia('banner')">
                            <button type="button" class="btn-cc btn-small btn-secondary" onclick="document.getElementById('banner-file-input').click()" style="width: 100%;">
                                Upload Banner
                            </button>
                        </div>
                    </div>

                    <h4 style="margin-top: 20px; margin-bottom: 12px; color: #fff; font-size: 0.95rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 6px;">
                        🔗 Community Links
                    </h4>

                    <div class="form-group">
                        <label>VRChat Group Link / Shortname</label>
                        <input type="url" id="partner-vrcgroup" value="<%= partner ? partner.vrcGroupUrl : '' %>" placeholder="https://vrc.group/FURN.9601">
                    </div>

                    <div class="form-group">
                        <label>Discord Invite Link</label>
                        <input type="url" id="partner-discord" value="<%= partner ? partner.discordInvite : '' %>" placeholder="https://discord.gg/yourclub">
                    </div>

                    <div class="form-group" style="margin-bottom: 25px;">
                        <label>Official Website URL (Optional)</label>
                        <input type="url" id="partner-website" value="<%= partner ? partner.websiteUrl : '' %>" placeholder="https://yourclub.com">
                    </div>

                    <button type="submit" class="btn-cc btn-primary" style="width: 100%; padding: 12px; font-weight: bold;">
                        💾 Save Partner Profile
                    </button>
                </form>
            </div>

            <% if (partner && partner.id) { %>
                <!-- PARTNER EVENTS SCHEDULE MANAGER -->
                <div class="staff-section">
                    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px;">
                        <h3 style="margin: 0; font-size: 1.1rem; color: #fff;">
                            📅 Upcoming Partner Events
                        </h3>
                        <button type="button" class="btn-cc btn-small btn-primary" onclick="openAddEventModal()">
                            ➕ Add Event
                        </button>
                    </div>

                    <div id="partner-events-list">
                        <% if (partner.events && partner.events.length > 0) { %>
                            <% partner.events.forEach(evt => { %>
                                <div style="background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; overflow: hidden; margin-bottom: 12px; display: flex; flex-direction: column;">
                                    <% if (evt.bannerUrl) { %>
                                        <div style="height: 100px; position: relative; background: #0c1219;">
                                            <img src="<%= evt.bannerUrl %>" alt="<%= evt.title %> Flyer" style="width: 100%; height: 100%; object-fit: cover;">
                                        </div>
                                    <% } %>
                                    <div style="padding: 15px; display: flex; align-items: flex-start; justify-content: space-between; gap: 15px;">
                                        <div style="flex: 1;">
                                            <h4 style="margin: 0 0 4px 0; color: #fff; font-size: 1rem;"><%= evt.title %></h4>
                                            <p style="margin: 0 0 8px 0; font-size: 0.78rem; color: <%= partner.accentColor || 'var(--primary-pink)' %>; font-weight: bold;">
                                                🕒 <%= new Date(evt.startTime).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) %> &rarr; <%= new Date(evt.endTime).toLocaleTimeString([], { timeStyle: 'short' }) %>
                                            </p>
                                            <% if (evt.description) { %>
                                                <div style="font-size: 0.8rem; color: #aaa; line-height: 1.4; white-space: pre-wrap;"><%= evt.description %></div>
                                            <% } %>
                                        </div>
                                        <div style="display: flex; gap: 8px;">
                                            <button type="button" class="btn-cc btn-small btn-dark" onclick="triggerEditEvent(<%= evt.id %>)">
                                                Edit
                                            </button>
                                            <button type="button" class="btn-cc btn-small btn-danger" onclick="deletePartnerEvent(<%= evt.id %>)">
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p style="font-size: 0.8rem; color: #777; font-style: italic; margin: 0;">No events added yet. Click 'Add Event' above to list an upcoming event!</p>
                        <% } %>
                    </div>
                </div>
            <% } %>

        </div>

        <!-- RIGHT: Live Showcase Preview -->
        <div class="staff-section" style="position: sticky; top: 90px; margin-bottom: 0;">
            <h3 style="margin-top: 0; margin-bottom: 15px; font-size: 0.85rem; color: #888; text-transform: uppercase; letter-spacing: 1px;">
                👁️ Live Showcase Preview
            </h3>

            <!-- Partner Card Preview -->
            <div id="preview-card" style="background: rgba(18, 24, 33, 0.95); border: 1px solid <%= (partner && partner.accentColor) ? partner.accentColor : 'rgba(242, 0, 141, 0.3)' %>; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                <div style="height: 100px; position: relative; background: #0a0e14; overflow: hidden;">
                    <img id="card-banner-preview" src="<%= (partner && partner.bannerUrl) ? partner.bannerUrl : '/cdn/logos/club/banner_fallback.jpg' %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/cdn/logos/club/Logo.png'">
                    <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 40%, rgba(18, 24, 33, 0.9) 100%);"></div>
                </div>

                <div style="padding: 0 15px 15px 15px; position: relative; margin-top: -35px;">
                    <div id="preview-icon-border" style="width: 60px; height: 60px; border-radius: 50%; border: 3px solid #121821; overflow: hidden; background: #111; box-shadow: 0 5px 15px rgba(0,0,0,0.5); margin-bottom: 10px;">
                        <img id="card-icon-preview" src="<%= (partner && partner.iconUrl) ? partner.iconUrl : '/cdn/logos/club/Logo.png' %>" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>

                    <h4 id="card-name-preview" style="margin: 0 0 5px 0; font-size: 1.1rem; color: #fff;">
                        <%= partner ? partner.name : 'Your Club Name' %>
                    </h4>

                    <p id="card-desc-preview" style="margin: 0 0 12px 0; font-size: 0.78rem; color: #aaa; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; white-space: pre-wrap;"><%= partner ? partner.description : 'Your club description will appear here on the public network directory.' %></p>

                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                        <span class="btn-cc btn-small" style="font-size: 0.65rem; pointer-events: none; opacity: 0.7;">Discord</span>
                        <span class="btn-cc btn-small" style="font-size: 0.65rem; pointer-events: none; opacity: 0.7;">VRChat</span>
                        <span class="btn-cc btn-small" style="font-size: 0.65rem; pointer-events: none; opacity: 0.7;">Partner Page</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<!-- ADD/EDIT PARTNER EVENT MODAL -->
<div id="event-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(8px); overflow-y: auto; padding: 20px;">
    <div class="staff-section" style="width: 540px; max-width: 95%; border: 1px solid var(--primary-pink); box-shadow: 0 15px 40px rgba(0,0,0,0.8); max-height: 90vh; overflow-y: auto;">
        <h3 id="event-modal-title" style="margin-top: 0; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 10px;">
            📅 Schedule Partner Event
        </h3>
        
        <form onsubmit="handleCreateEvent(event)">
            <input type="hidden" id="evt-id">

            <div class="form-group">
                <label>Event Title *</label>
                <input type="text" id="evt-title" placeholder="e.g. Neon Nights Vol. 3" required>
            </div>

            <!-- EVENT FLYER BANNER ENTRYPOINT -->
            <div class="form-group">
                <label style="color: var(--primary-pink); font-weight: bold;">Event Flyer / Banner Image (Optional)</label>
                <input type="hidden" id="evt-banner-url">
                <div id="evt-flyer-preview-box" style="display: none; width: 100%; height: 110px; border-radius: 8px; overflow: hidden; margin-bottom: 8px; border: 1px solid rgba(255,255,255,0.2); background: #000; position: relative;">
                    <img id="evt-flyer-img" src="" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
                <input type="file" id="evt-flyer-file-input" accept="image/*" style="display: none;" onchange="uploadEventFlyerMedia()">
                <button type="button" class="btn-cc btn-small btn-secondary" onclick="document.getElementById('evt-flyer-file-input').click()" style="width: 100%;">
                    🖼️ Upload Event Flyer / Banner Image
                </button>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div class="form-group">
                    <label>Start Time *</label>
                    <input type="datetime-local" id="evt-start" required style="color: #fff;">
                </div>
                <div class="form-group">
                    <label>End Time *</label>
                    <input type="datetime-local" id="evt-end" required style="color: #fff;">
                </div>
            </div>

            <div class="form-group">
                <label style="color: var(--primary-blue);">Your Timezone (Auto-converts all times to UTC) *</label>
                <select id="evt-timezone">
                    <option value="UTC">UTC / GMT (Coordinated Universal Time)</option>
                    <option value="America/New_York">US Eastern (EST/EDT)</option>
                    <option value="America/Chicago">US Central (CST/CDT)</option>
                    <option value="America/Denver">US Mountain (MST/MDT)</option>
                    <option value="America/Los_Angeles">US Pacific (PST/PDT)</option>
                    <option value="Europe/London">UK / London (GMT/BST)</option>
                    <option value="Europe/Berlin">Central Europe (CET/CEST)</option>
                    <option value="Asia/Tokyo">Japan (JST)</option>
                    <option value="Australia/Sydney">Australia Eastern (AEST/AEDT)</option>
                </select>
            </div>

            <!-- STRUCTURED DJ LINEUP BUILDER -->
            <div style="background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 12px; margin-bottom: 15px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
                    <label style="font-size: 0.85rem; font-weight: bold; color: var(--primary-blue); margin: 0;">
                        🎧 DJ Lineup Timetable
                    </label>
                    <button type="button" class="btn-cc btn-small btn-primary" onclick="addDjLineupSlot()" style="padding: 3px 10px; font-size: 0.75rem;">
                        + Add DJ Slot
                    </button>
                </div>
                <div id="dj-lineup-slots" style="display: flex; flex-direction: column; gap: 8px;"></div>
            </div>

            <div class="form-group">
                <label>Additional Event Details & Description</label>
                <textarea id="evt-desc" rows="3" placeholder="Additional event details, VRChat world info, or guidelines..."></textarea>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label>Event / World URL (Optional)</label>
                <input type="url" id="evt-url" placeholder="https://vrc.group/... or VRChat world link">
            </div>

            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" class="btn-cc btn-secondary" onclick="closeAddEventModal()">Cancel</button>
                <button type="submit" class="btn-cc btn-primary">Save Event</button>
            </div>
        </form>
    </div>
</div>

<script>
    const partnerEventsData = <%- JSON.stringify((partner && partner.events) ? partner.events : []) %>;

    function triggerEditEvent(eventId) {
        const evt = (partnerEventsData || []).find(e => e.id === eventId);
        if (evt) openEditEventModal(evt);
    }

    function updatePreviewColor(color) {
        const card = document.getElementById('preview-card');
        const iconBox = document.getElementById('icon-preview-box');
        if (card) card.style.borderColor = color;
        if (iconBox) iconBox.style.borderColor = color;
    }

    // Live text update handlers for preview
    document.getElementById('partner-name').addEventListener('input', (e) => {
        document.getElementById('card-name-preview').innerText = e.target.value.trim() || 'Your Club Name';
    });

    document.getElementById('partner-description').addEventListener('input', (e) => {
        document.getElementById('card-desc-preview').innerText = e.target.value.trim() || 'Your club description will appear here on the public network directory.';
    });

    let djSlotCounter = 0;
    function addDjLineupSlot(data = {}) {
        const container = document.getElementById('dj-lineup-slots');
        const slotId = `dj-slot-${++djSlotCounter}`;
        const div = document.createElement('div');
        div.id = slotId;
        div.className = 'dj-lineup-row';
        div.style.cssText = 'display: grid; grid-template-columns: 85px 85px 1fr 1fr 28px; gap: 6px; align-items: center; background: rgba(0,0,0,0.3); padding: 8px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.05);';
        
        div.innerHTML = `
            <input type="time" class="dj-start-time input-cc" value="${data.start || ''}" style="padding: 5px; font-size: 0.75rem; color: #fff; width: 100%; box-sizing: border-box;" title="Start Time">
            <input type="time" class="dj-end-time input-cc" value="${data.end || ''}" style="padding: 5px; font-size: 0.75rem; color: #fff; width: 100%; box-sizing: border-box;" title="End Time">
            <input type="text" class="dj-name input-cc" placeholder="DJ / Performer" value="${data.name || ''}" style="padding: 5px 8px; font-size: 0.75rem; width: 100%; box-sizing: border-box;" title="DJ Name">
            <input type="text" class="dj-genre input-cc" placeholder="Genre (e.g. House)" value="${data.genre || ''}" style="padding: 5px 8px; font-size: 0.75rem; width: 100%; box-sizing: border-box;" title="Genre">
            <button type="button" class="btn-cc btn-small" onclick="document.getElementById('${slotId}').remove()" style="padding: 4px; color: #ff4444; border-color: rgba(255,68,68,0.3); font-size: 0.75rem; width: 100%; text-align: center;" title="Remove DJ">&times;</button>
        `;
        container.appendChild(div);
    }

    function formatForDatetimeLocal(isoStr) {
        if (!isoStr) return '';
        const d = new Date(isoStr);
        const pad = n => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }

    function openEditEventModal(evt) {
        document.getElementById('event-modal-title').innerText = '✏️ Edit Partner Event';
        document.getElementById('evt-id').value = evt.id;
        document.getElementById('evt-title').value = evt.title || '';

        const evtTz = evt.timezone || 'UTC';
        const tzSelect = document.getElementById('evt-timezone');
        if (tzSelect && evtTz) tzSelect.value = evtTz;

        document.getElementById('evt-start').value = formatForDatetimeLocal(evt.startTime);
        document.getElementById('evt-end').value = formatForDatetimeLocal(evt.endTime);
        document.getElementById('evt-url').value = evt.eventUrl || '';
        
        if (evt.bannerUrl) {
            document.getElementById('evt-banner-url').value = evt.bannerUrl;
            document.getElementById('evt-flyer-img').src = evt.bannerUrl;
            document.getElementById('evt-flyer-preview-box').style.display = 'block';
        } else {
            document.getElementById('evt-banner-url').value = '';
            document.getElementById('evt-flyer-img').src = '';
            document.getElementById('evt-flyer-preview-box').style.display = 'none';
        }

        document.getElementById('dj-lineup-slots').innerHTML = '';
        let desc = evt.description || '';

        // Check for structured lineup JSON first
        let lineupArray = [];
        if (evt.lineup) {
            try { lineupArray = typeof evt.lineup === 'string' ? JSON.parse(evt.lineup) : evt.lineup; } catch(e) {}
        }

        if (Array.isArray(lineupArray) && lineupArray.length > 0) {
            lineupArray.forEach(slot => {
                let startStr = '', endStr = '';
                if (slot.startUtc) {
                    const d = new Date(slot.startUtc);
                    startStr = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
                }
                if (slot.endUtc) {
                    const d = new Date(slot.endUtc);
                    endStr = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
                }
                addDjLineupSlot({ start: startStr || slot.start, end: endStr || slot.end, name: slot.djName || slot.name, genre: slot.genre });
            });
            document.getElementById('evt-desc').value = desc.trim();
        } else if (desc.includes('🎧 LINEUP & TIMETABLE:')) {
            const parts = desc.split('🎧 LINEUP & TIMETABLE:');
            const lineupSection = parts[1] ? parts[1].split('\n\n')[0] : '';
            const customDesc = parts[1] ? parts[1].split('\n\n').slice(1).join('\n\n') : (parts[0] || '');

            document.getElementById('evt-desc').value = (customDesc || '').trim();

            const lines = lineupSection.split('\n');
            lines.forEach(line => {
                line = line.trim();
                if (!line || line.startsWith('🎧')) return;
                let start = '', end = '', name = '', genre = '';
                if (line.includes('(') && line.endsWith(')')) {
                    genre = line.substring(line.lastIndexOf('(') + 1, line.length - 1);
                    line = line.substring(0, line.lastIndexOf('(')).trim();
                }
                if (line.includes('|')) {
                    const timePart = line.split('|')[0].replace('🕒', '').trim();
                    name = line.split('|')[1].trim();
                    if (timePart.includes('-')) {
                        start = timePart.split('-')[0].trim();
                        end = timePart.split('-')[1].trim();
                    }
                } else {
                    name = line;
                }
                if (name) addDjLineupSlot({ start, end, name, genre });
            });
        } else {
            document.getElementById('evt-desc').value = desc.trim();
        }

        document.getElementById('event-modal').style.display = 'flex';
    }

    async function uploadEventFlyerMedia() {
        const fileInput = document.getElementById('evt-flyer-file-input');
        if (!fileInput.files || !fileInput.files[0]) return;

        const file = fileInput.files[0];
        if (file.size > 10 * 1024 * 1024) {
            return showNotify('Flyer image is too large! Maximum allowed size is 10MB.', 'error');
        }

        const formData = new FormData();
        formData.append('flyer', file);

        showNotify('Uploading event flyer...', 'info');

        try {
            const res = await fetch('/api/partner/events/upload-flyer', {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            if (data.success) {
                document.getElementById('evt-banner-url').value = data.flyerUrl;
                document.getElementById('evt-flyer-img').src = data.flyerUrl;
                document.getElementById('evt-flyer-preview-box').style.display = 'block';
                showNotify('Event flyer uploaded successfully!', 'success');
            } else {
                showNotify(data.error || 'Failed to upload event flyer', 'error');
            }
        } catch (err) {
            console.error(err);
            showNotify('Error uploading event flyer', 'error');
        }
    }

    async function uploadMedia(type) {
        const fileInput = document.getElementById(`${type}-file-input`);
        if (!fileInput.files || !fileInput.files[0]) return;

        const file = fileInput.files[0];
        if (file.size > 10 * 1024 * 1024) {
            return showNotify('File is too large! Maximum allowed size is 10MB.', 'error');
        }

        const formData = new FormData();
        const partnerIdEl = document.getElementById('partner-id');
        if (partnerIdEl && partnerIdEl.value) formData.append('partnerId', partnerIdEl.value);
        formData.append(type, file);

        showNotify(`Uploading ${type}...`, 'info');

        try {
            const endpoint = `/api/partner/upload-${type}`;
            const res = await fetch(endpoint, {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            if (data.success) {
                const url = type === 'icon' ? data.iconUrl : data.bannerUrl;
                document.getElementById(`${type}-preview`).src = url;
                document.getElementById(`card-${type}-preview`).src = url;
                showNotify(`Club ${type} uploaded successfully!`, 'success');
            } else {
                showNotify(data.error || `Failed to upload ${type}`, 'error');
            }
        } catch (err) {
            console.error(err);
            showNotify(`Error uploading ${type}`, 'error');
        }
    }

    async function handlePartnerSubmit(event) {
        event.preventDefault();

        const partnerIdEl = document.getElementById('partner-id');
        const payload = {
            id: partnerIdEl ? partnerIdEl.value : undefined,
            name: document.getElementById('partner-name').value.trim(),
            customSlug: document.getElementById('partner-slug').value.trim(),
            accentColor: document.getElementById('partner-color').value.trim(),
            description: document.getElementById('partner-description').value.trim(),
            vrcGroupUrl: document.getElementById('partner-vrcgroup').value.trim(),
            discordInvite: document.getElementById('partner-discord').value.trim(),
            websiteUrl: document.getElementById('partner-website').value.trim()
        };

        try {
            const res = await fetch('/api/partner/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (data.success) {
                showNotify('Partner profile saved!', 'success');
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showNotify(data.error || 'Failed to save partner profile', 'error');
            }
        } catch (err) {
            console.error(err);
            showNotify('Network error saving profile', 'error');
        }
    }

    function openAddEventModal() {
        document.getElementById('event-modal-title').innerText = '📅 Schedule Partner Event';
        document.getElementById('evt-id').value = '';
        document.getElementById('evt-title').value = '';
        document.getElementById('evt-start').value = '';
        document.getElementById('evt-end').value = '';
        document.getElementById('evt-url').value = '';
        document.getElementById('evt-desc').value = '';
        document.getElementById('evt-banner-url').value = '';
        document.getElementById('evt-flyer-img').src = '';
        document.getElementById('evt-flyer-preview-box').style.display = 'none';
        document.getElementById('dj-lineup-slots').innerHTML = '';

        try {
            const userTz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            const tzSelect = document.getElementById('evt-timezone');
            if (tzSelect && userTz) {
                for (let opt of tzSelect.options) {
                    if (opt.value === userTz) { opt.selected = true; break; }
                }
            }
        } catch(e) {}

        document.getElementById('event-modal').style.display = 'flex';
    }

    function closeAddEventModal() {
        document.getElementById('event-modal').style.display = 'none';
    }

    function convertLocalTzToUtc(datetimeLocalStr, timezoneStr) {
        if (!datetimeLocalStr) return null;
        try {
            const [datePart, timePart] = datetimeLocalStr.split('T');
            const [year, month, day] = datePart.split('-').map(Number);
            const [hours, minutes] = timePart.split(':').map(Number);

            const dummyDate = new Date(Date.UTC(year, month - 1, day, hours, minutes));
            const formatter = new Intl.DateTimeFormat('en-US', {
                timeZone: timezoneStr,
                year: 'numeric', month: '2-digit', day: '2-digit',
                hour: '2-digit', minute: '2-digit', second: '2-digit',
                hour12: false
            });
            const parts = formatter.formatToParts(dummyDate);
            const p = {};
            parts.forEach(pt => p[pt.type] = pt.value);
            
            const tzYear = parseInt(p.year, 10);
            const tzMonth = parseInt(p.month, 10);
            const tzDay = parseInt(p.day, 10);
            const tzHour = parseInt(p.hour === '24' ? '0' : p.hour, 10);
            const tzMin = parseInt(p.minute, 10);

            const tzAsUtc = Date.UTC(tzYear, tzMonth - 1, tzDay, tzHour, tzMin);
            const dummyAsUtc = dummyDate.getTime();
            const diffMs = tzAsUtc - dummyAsUtc;

            return new Date(dummyAsUtc - diffMs).toISOString();
        } catch (e) {
            return new Date(datetimeLocalStr).toISOString();
        }
    }

    async function handleCreateEvent(event) {
        event.preventDefault();
        const partnerIdEl = document.getElementById('partner-id');
        if (!partnerIdEl) return showNotify('Save partner profile first!', 'error');

        const eventId = document.getElementById('evt-id').value;
        const timezone = document.getElementById('evt-timezone').value;
        const startLocal = document.getElementById('evt-start').value;
        const endLocal = document.getElementById('evt-end').value;

        const startUtc = convertLocalTzToUtc(startLocal, timezone);
        const endUtc = convertLocalTzToUtc(endLocal, timezone);

        if (new Date(endUtc) <= new Date(startUtc)) {
            return showNotify('End Time must be set after Start Time!', 'error');
        }

        // Build DJ Lineup array with UTC timestamps for timezone sync
        const lineupRows = document.querySelectorAll('.dj-lineup-row');
        const lineupData = [];
        const eventStartDate = startLocal ? startLocal.split('T')[0] : '';

        if (lineupRows.length > 0 && eventStartDate) {
            lineupRows.forEach(row => {
                const djStart = row.querySelector('.dj-start-time').value;
                const djEnd = row.querySelector('.dj-end-time').value;
                const djName = row.querySelector('.dj-name').value.trim();
                const genre = row.querySelector('.dj-genre').value.trim();

                if (djName) {
                    let slotStartUtc = null;
                    let slotEndUtc = null;

                    if (djStart) {
                        slotStartUtc = convertLocalTzToUtc(`${eventStartDate}T${djStart}`, timezone);
                    }
                    if (djEnd) {
                        slotEndUtc = convertLocalTzToUtc(`${eventStartDate}T${djEnd}`, timezone);
                    }

                    lineupData.push({
                        djName,
                        genre,
                        start: djStart,
                        end: djEnd,
                        startUtc: slotStartUtc,
                        endUtc: slotEndUtc
                    });
                }
            });
        }

        const customBio = document.getElementById('evt-desc').value.trim();

        const payload = {
            partnerId: partnerIdEl.value,
            title: document.getElementById('evt-title').value.trim(),
            startTime: startUtc,
            endTime: endUtc,
            timezone: timezone,
            description: customBio,
            lineup: lineupData,
            eventUrl: document.getElementById('evt-url').value.trim(),
            bannerUrl: document.getElementById('evt-banner-url').value
        };

        const endpoint = eventId ? `/api/partner/events/${eventId}` : '/api/partner/events/create';
        const method = eventId ? 'PUT' : 'POST';

        try {
            const res = await fetch(endpoint, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                showNotify(eventId ? 'Partner event updated!' : 'Partner event created!', 'success');
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showNotify(data.error || 'Failed to save event', 'error');
            }
        } catch (err) {
            showNotify('Error saving event', 'error');
        }
    }

    async function deletePartnerEvent(eventId) {
        if (!confirm('Are you sure you want to delete this event?')) return;
        try {
            const res = await fetch(`/api/partner/events/${eventId}`, {
                method: 'DELETE'
            });
            const data = await res.json();
            if (data.success) {
                showNotify('Event deleted', 'success');
                setTimeout(() => window.location.reload(), 500);
            } else {
                showNotify(data.error || 'Failed to delete event', 'error');
            }
        } catch (err) {
            showNotify('Error deleting event', 'error');
        }
    }
</script>

