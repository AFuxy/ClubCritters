<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Furry Rave Night - <%= title %></title>
    
    <link rel="icon" type="image/png" href="/cdn/logos/club/favicon.png">
    <link rel="stylesheet" href="/cdn/css/main.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/events.css">
    <link rel="preconnect" href="https://docs.google.com">
    <link rel="preconnect" href="https://sheets.googleapis.com">

    <meta name="title" content="Club FuRN - <%= title %>">
    <meta name="description" content="<%= locals.description || 'The Club FuRN Community Hub. Check event times, DJ lineups, and join us in VRChat!' %>">
    <meta name="theme-color" content="<%= locals.themeColor || '#f2008d' %>">

    <meta property="og:site_name" content="Club FuRN Network">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= locals.ogTitle || ('Club FuRN - ' + title) %>">
    <meta property="og:description" content="<%= locals.description || 'The Club FuRN Community Hub. Check event times, DJ lineups, and join us in VRChat!' %>">
    <meta property="og:image" content="<%= locals.ogImage || 'https://clubfurn.com/cdn/logos/club/Logo.png' %>">

    <meta name="twitter:card" content="<%= locals.ogImage ? 'summary_large_image' : 'summary' %>">
    <meta name="twitter:title" content="<%= locals.ogTitle || ('Club FuRN - ' + title) %>">
    <meta name="twitter:description" content="<%= locals.description || 'The Club FuRN Community Hub. Check event times, DJ lineups, and join us in VRChat!' %>">
    <meta name="twitter:image" content="<%= locals.ogImage || 'https://clubfurn.com/cdn/logos/club/Logo.png' %>">
</head>
