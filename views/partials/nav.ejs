<div id="main-nav" class="nav-container">
    <% if (page === 'index') { %>
        <a href="/archive" id="archive-link" class="btn-cc nav-pill-cc">Archive</a>
        <a href="/events" id="events-link" class="btn-cc nav-pill-cc">Events</a>
        <a href="/gallery" id="gallery-link" class="btn-cc nav-pill-cc">Gallery</a>
        <div class="dropdown-cc" style="display: inline-block;">
            <button class="btn-cc nav-pill-cc">Community <span style="font-size: 0.6rem; margin-left: 3px; opacity: 0.7;">▼</span></button>
            <div class="dropdown-content-cc">
                <a href="/team">Team</a>
                <a href="/partners">Partners</a>
            </div>
        </div>
    <% } else { %>
        <a href="/" class="btn-cc nav-pill-cc">Hub</a>
        <% if (page !== 'archive') { %><a href="/archive" class="btn-cc nav-pill-cc">Archive</a><% } %>
        <% if (page !== 'events') { %><a href="/events" class="btn-cc nav-pill-cc">Events</a><% } %>
        <% if (page !== 'gallery') { %><a href="/gallery" class="btn-cc nav-pill-cc">Gallery</a><% } %>
        <div class="dropdown-cc" style="display: inline-block;">
            <button class="btn-cc nav-pill-cc <%= ['team', 'partners', 'partner'].includes(page) ? 'active' : '' %>">Community <span style="font-size: 0.6rem; margin-left: 3px; opacity: 0.7;">▼</span></button>
            <div class="dropdown-content-cc">
                <% if (page !== 'team') { %><a href="/team">Team</a><% } %>
                <% if (page !== 'partners') { %><a href="/partners">Partners</a><% } %>
            </div>
        </div>
    <% } %>
</div>
