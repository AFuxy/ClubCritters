<div id="main-nav" class="nav-container">
    <% if (typeof user !== 'undefined' && user) { %>
        <% 
            let panelLink = '/panel';
            let panelLabel = 'Panel';
            const navUserType = (user.type || "").toLowerCase();
            const isStaffNavUser = ['host', 'staff', 'owner'].some(r => navUserType.includes(r));
            if (page === 'archive') {
                panelLink = '/panel/archives';
                panelLabel = 'Archive Panel';
            } else if (page === 'events' && isStaffNavUser) {
                panelLink = '/panel/schedule';
                panelLabel = 'Schedule Panel';
            } else if ((page === 'partners' || page === 'partner') && (isStaffNavUser || navUserType.includes('partner'))) {
                panelLink = '/panel/partner';
                panelLabel = 'Partner Panel';
            }
        %>
        <a href="<%= panelLink %>" class="btn-cc nav-pill-cc floating-panel-btn" style="position: fixed; top: 20px; left: 20px; z-index: 999; background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.4); backdrop-filter: blur(10px); color: #fff; font-size: 0.8rem; padding: 6px 14px; box-shadow: 0 4px 15px rgba(0,0,0,0.4); text-transform: none; letter-spacing: 0.5px; transition: all 0.2s ease;">
            ⚙️ <%= panelLabel %>
        </a>
    <% } %>

    <% if (page === 'index') { %>
        <a href="/archive" id="archive-link" class="btn-cc nav-pill-cc">Archive</a>
        <a href="/events" id="events-link" class="btn-cc nav-pill-cc">Events</a>
        <a href="/gallery" id="gallery-link" class="btn-cc nav-pill-cc">Gallery</a>
        <div class="dropdown-cc" style="display: inline-block;">
            <button class="btn-cc nav-pill-cc">Community <span style="font-size: 0.6rem; margin-left: 3px; opacity: 0.7;">▼</span></button>
            <div class="dropdown-content-cc">
                <a href="/djs">DJs</a>
                <a href="/team">Team</a>
                <a href="/vips">VIPs</a>
                <a href="/partners">Partners</a>
                <a href="/partner-with-us">Partner With Us</a>
            </div>
        </div>
    <% } else { %>
        <a href="/" class="btn-cc nav-pill-cc">Hub</a>
        <% if (page !== 'archive') { %><a href="/archive" class="btn-cc nav-pill-cc">Archive</a><% } %>
        <% if (page !== 'events') { %><a href="/events" class="btn-cc nav-pill-cc">Events</a><% } %>
        <% if (page !== 'gallery') { %><a href="/gallery" class="btn-cc nav-pill-cc">Gallery</a><% } %>
        <div class="dropdown-cc" style="display: inline-block;">
            <button class="btn-cc nav-pill-cc <%= ['djs', 'team', 'vips', 'partners', 'partner', 'partner-with-us'].includes(page) ? 'active' : '' %>">Community <span style="font-size: 0.6rem; margin-left: 3px; opacity: 0.7;">▼</span></button>
            <div class="dropdown-content-cc">
                <% if (page !== 'djs') { %><a href="/djs">DJs</a><% } %>
                <% if (page !== 'team') { %><a href="/team">Team</a><% } %>
                <% if (page !== 'vips') { %><a href="/vips">VIPs</a><% } %>
                <% if (page !== 'partners') { %><a href="/partners">Partners</a><% } %>
                <% if (page !== 'partner-with-us') { %><a href="/partner-with-us">Partner With Us</a><% } %>
            </div>
        </div>
    <% } %>
</div>
