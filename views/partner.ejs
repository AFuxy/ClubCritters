<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { 
    title: partner.name + ' - Partner Club', 
    page: 'partner', 
    description: partner.description || (partner.name + ' Partner Showcase Page on Club FuRN Network.'),
    ogTitle: partner.name + ' — Affiliated Partner Club',
    ogImage: partner.bannerUrl || partner.iconUrl || '/cdn/logos/club/banner_fallback.jpg',
    themeColor: partner.accentColor || '#f2008d'
}) %>
<body>

    <div class="container" style="max-width: 1000px;">
        <%- include('partials/nav', { page: 'partner' }) %>

        <!-- BACK LINK -->
        <div style="margin-bottom: 20px;">
            <a href="/partners" class="btn-cc btn-secondary" style="text-decoration: none; font-size: 0.85rem;">
                &larr; Back to Partner Directory
            </a>
        </div>

        <% const accent = partner.accentColor || '#f2008d'; %>

        <!-- HERO SHOWCASE BANNER -->
        <div style="background: rgba(21, 30, 41, 0.9); border: 1px solid <%= accent %>; border-radius: 20px; overflow: hidden; box-shadow: 0 15px 40px rgba(0,0,0,0.6); margin-bottom: 35px;">
            
            <!-- Banner Image -->
            <div style="height: 220px; position: relative; background: #0c1219; overflow: hidden;">
                <img src="<%= partner.bannerUrl || '/cdn/logos/club/banner_fallback.jpg' %>" alt="<%= partner.name %> Banner" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/cdn/logos/club/Logo.png'">
                <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 20%, rgba(21, 30, 41, 0.95) 100%);"></div>
            </div>

            <!-- Profile Info Overlay -->
            <div style="padding: 0 30px 30px 30px; position: relative; margin-top: -60px;">
                <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-bottom: 20px;">
                    
                    <div style="display: flex; align-items: flex-end; gap: 20px; flex-wrap: wrap;">
                        <!-- Icon -->
                        <div style="width: 110px; height: 110px; border-radius: 50%; border: 4px solid <%= accent %>; overflow: hidden; background: #111; box-shadow: 0 8px 25px rgba(0,0,0,0.6);">
                            <img src="<%= partner.iconUrl || '/cdn/logos/club/Logo.png' %>" alt="<%= partner.name %> Icon" style="width: 100%; height: 100%; object-fit: cover;">
                        </div>

                        <div>
                            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 5px;">
                                <span style="font-size: 0.75rem; padding: 3px 10px; border-radius: 20px; font-weight: bold; background: rgba(255,255,255,0.05); color: <%= accent %>; border: 1px solid <%= accent %>;">
                                    Affiliated Partner
                                </span>
                            </div>
                            <h1 style="margin: 0; font-size: 2.2rem; color: #fff; text-align: left; border: none; padding: 0; text-transform: none;">
                                <%= partner.name %>
                            </h1>
                        </div>
                    </div>

                    <!-- Action Link Buttons -->
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <% if (partner.discordInvite) { %>
                            <a href="<%= partner.discordInvite %>" target="_blank" class="btn-cc" style="text-decoration: none; background: #5865F2; color: #fff; font-weight: bold;">
                                Join Discord
                            </a>
                        <% } %>
                        <% if (partner.vrcGroupUrl) { %>
                            <a href="<%= partner.vrcGroupUrl %>" target="_blank" class="btn-cc" style="text-decoration: none; background: <%= accent %>; color: #fff; font-weight: bold; border-color: <%= accent %>;">
                                VRChat Group
                            </a>
                        <% } %>
                        <% if (partner.websiteUrl) { %>
                            <a href="<%= partner.websiteUrl %>" target="_blank" class="btn-cc btn-secondary" style="text-decoration: none;">
                                Website
                            </a>
                        <% } %>
                    </div>
                </div>

                <!-- Bio / Description -->
                <div style="background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; padding: 20px; margin-top: 15px;">
                    <h3 style="margin-top: 0; margin-bottom: 10px; font-size: 1rem; color: <%= accent %>; text-transform: uppercase; letter-spacing: 1px;">
                        About <%= partner.name %>
                    </h3>
                    <div style="color: #ccc; line-height: 1.6; font-size: 0.95rem; white-space: pre-wrap;"><%= partner.description || 'No detailed description provided yet.' %></div>
                </div>

                <!-- Club Leads & Team Section -->
                <% 
                    const teamMembers = [];
                    if (partner.owner) {
                        teamMembers.push({
                            discordId: partner.owner.discordId,
                            name: partner.owner.name,
                            imageUrl: partner.owner.imageUrl,
                            title: partner.owner.title || 'Club Owner',
                            isOwner: true
                        });
                    }
                    if (typeof coOwners !== 'undefined' && coOwners && coOwners.length > 0) {
                        coOwners.forEach(co => {
                            if (co.discordId !== partner.ownerDiscordId) {
                                teamMembers.push({
                                    discordId: co.discordId,
                                    name: co.name,
                                    imageUrl: co.imageUrl,
                                    title: co.title || 'Club Co-Owner',
                                    isOwner: false
                                });
                            }
                        });
                    }
                %>
                <% if (teamMembers.length > 0) { %>
                    <div style="background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.06); border-radius: 14px; padding: 18px 20px; margin-top: 15px;">
                        <h3 style="margin-top: 0; margin-bottom: 12px; font-size: 0.9rem; color: <%= accent %>; text-transform: uppercase; letter-spacing: 1px;">
                            Club Team & Hosts
                        </h3>
                        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                            <% teamMembers.forEach(tm => { %>
                                <a href="/performer/<%= tm.discordId %>" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); padding: 8px 14px; border-radius: 12px; transition: all 0.2s ease;">
                                    <img src="<%= tm.imageUrl || '/cdn/logos/club/Logo.png' %>" style="width: 34px; height: 34px; border-radius: 50%; object-fit: cover; border: 1px solid <%= tm.isOwner ? '#ffd700' : accent %>;">
                                    <div>
                                        <div style="font-weight: bold; font-size: 0.85rem; color: #fff;">
                                            <%= tm.name %> <%= tm.isOwner ? '👑' : '' %>
                                        </div>
                                        <div style="font-size: 0.72rem; color: #888;"><%= tm.title %></div>
                                    </div>
                                </a>
                            <% }) %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- PARTNER EVENTS SECTION CONTAINER -->
        <div style="background: rgba(21, 30, 41, 0.8); border: 1px solid rgba(255,255,255,0.08); border-radius: 20px; padding: 30px; margin-bottom: 50px;">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 15px; margin-bottom: 25px;">
                <h2 style="margin: 0; font-size: 1.4rem; color: #fff; border: none; padding: 0;">
                    Upcoming Events & Schedule
                </h2>
                <span style="font-size: 0.75rem; background: rgba(255,255,255,0.05); color: <%= accent %>; border: 1px solid <%= accent %>; padding: 4px 12px; border-radius: 20px;">
                    Club Showcase Events
                </span>
            </div>

            <!-- Events Content -->
            <div id="partner-events-container">
                <% if (partner.events && partner.events.length > 0) { %>
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;">
                        <% partner.events.forEach(evt => { %>
                            <% 
                                const now = new Date();
                                const start = new Date(evt.startTime);
                                const end = new Date(evt.endTime);
                                const isLive = now >= start && now < end;
                                const isEnded = now >= end;

                                let badgeLabel = 'UPCOMING';
                                let badgeBg = 'rgba(255,255,255,0.05)';
                                let badgeColor = accent;
                                let badgeBorder = accent;

                                if (isLive) {
                                    badgeLabel = 'LIVE NOW';
                                    badgeBg = 'rgba(255,23,68,0.2)';
                                    badgeColor = '#ff1744';
                                    badgeBorder = '#ff1744';
                                } else if (isEnded) {
                                    badgeLabel = 'ENDED';
                                    badgeBg = 'rgba(255,255,255,0.04)';
                                    badgeColor = '#888888';
                                    badgeBorder = '#444444';
                                }

                                let lineupSlots = [];
                                if (evt.lineup) {
                                    try { lineupSlots = typeof evt.lineup === 'string' ? JSON.parse(evt.lineup) : evt.lineup; } catch(e) {}
                                }
                            %>
                            <div style="background: rgba(12, 18, 25, 0.9); border: 1px solid <%= isLive ? '#ff1744' : (isEnded ? '#333' : accent) %>; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; opacity: <%= isEnded ? '0.75' : '1' %>; box-shadow: <%= isLive ? '0 0 25px rgba(255,23,68,0.3)' : '0 5px 20px rgba(0,0,0,0.4)' %>;">
                                
                                <% if (evt.bannerUrl) { %>
                                    <div style="height: 180px; position: relative; background: #080c10; overflow: hidden; display: flex; justify-content: center; align-items: center; cursor: pointer; group:" onclick="openFlyerLightbox('<%= evt.bannerUrl %>', '<%= evt.title.replace(/'/g, "\\'") %>')">
                                        <img src="<%= evt.bannerUrl %>" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: blur(12px) opacity(0.3); transform: scale(1.1);">
                                        <img src="<%= evt.bannerUrl %>" alt="<%= evt.title %> Flyer" style="max-width: 100%; max-height: 180px; object-fit: contain; position: relative; z-index: 2; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform='scale(1)'">
                                        
                                        <!-- Click to Enlarge Badge -->
                                        <div style="position: absolute; bottom: 8px; right: 8px; z-index: 4; background: rgba(0,0,0,0.75); color: #fff; padding: 3px 8px; border-radius: 6px; font-size: 0.7rem; backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.15); pointer-events: none;">
                                            🔍 Click to enlarge
                                        </div>
                                    </div>
                                <% } %>

                                <div style="padding: 20px; flex: 1; display: flex; flex-direction: column;">
                                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin-bottom: 10px;">
                                        <span style="font-size: 0.7rem; font-weight: 900; padding: 3px 10px; border-radius: 20px; text-transform: uppercase; background: <%= badgeBg %>; color: <%= badgeColor %>; border: 1px solid <%= badgeBorder %>;">
                                            <%= badgeLabel %>
                                        </span>
                                        <% if (evt.isStreamedByClubFurn) { %>
                                            <span style="font-size: 0.68rem; font-weight: bold; padding: 3px 8px; border-radius: 12px; background: rgba(88,101,242,0.15); color: #5865F2; border: 1px solid #5865F2;">
                                                📡 Official Live Stream by Club FuRN
                                            </span>
                                        <% } %>
                                    </div>

                                    <h3 style="margin: 0 0 8px 0; color: #fff; font-size: 1.15rem; border: none; padding: 0;">
                                        <%= evt.title %>
                                    </h3>

                                    <p style="font-size: 0.8rem; color: <%= accent %>; margin: 0 0 14px 0; font-weight: bold;">
                                        🕒 <%= start.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) %> &rarr; <%= end.toLocaleTimeString([], { timeStyle: 'short' }) %>
                                    </p>

                                    <!-- TIMEZONE SYNCED DJ LINEUP TIMETABLE -->
                                    <% if (Array.isArray(lineupSlots) && lineupSlots.length > 0) { %>
                                        <div style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 12px; margin-bottom: 15px;">
                                            <div style="font-size: 0.75rem; font-weight: bold; color: <%= accent %>; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px;">
                                                🎧 LINEUP TIMETABLE
                                            </div>
                                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                                <% lineupSlots.forEach(slot => { %>
                                                    <% 
                                                        let timeRange = '';
                                                        if (slot.startUtc && slot.endUtc) {
                                                            const s = new Date(slot.startUtc).toLocaleTimeString([], { timeStyle: 'short' });
                                                            const e = new Date(slot.endUtc).toLocaleTimeString([], { timeStyle: 'short' });
                                                            timeRange = `${s} - ${e}`;
                                                        } else if (slot.start || slot.end) {
                                                            timeRange = `${slot.start || ''} - ${slot.end || ''}`;
                                                        }
                                                    %>
                                                    <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; padding-bottom: 4px; border-bottom: 1px dashed rgba(255,255,255,0.05);">
                                                        <div style="display: flex; align-items: center; gap: 8px;">
                                                            <% if (timeRange) { %>
                                                                <span style="color: #aaa; font-family: monospace; font-size: 0.75rem;"><%= timeRange %></span>
                                                            <% } %>
                                                            <strong style="color: #fff;"><%= slot.djName || slot.name %></strong>
                                                        </div>
                                                        <% if (slot.genre) { %>
                                                            <span style="font-size: 0.7rem; color: #888; background: rgba(255,255,255,0.05); padding: 2px 6px; border-radius: 4px;"><%= slot.genre %></span>
                                                        <% } %>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        </div>
                                    <% } %>

                                    <% if (evt.description) { %>
                                        <div style="font-size: 0.85rem; color: #aaa; margin: 0 0 15px 0; line-height: 1.5; white-space: pre-wrap; flex: 1;"><%= evt.description %></div>
                                    <% } %>

                                    <%
                                        let streamUrlsObj = {};
                                        if (evt.streamUrls) {
                                            try { streamUrlsObj = typeof evt.streamUrls === 'string' ? JSON.parse(evt.streamUrls) : evt.streamUrls; } catch(e) {}
                                        }
                                    %>

                                    <div style="display: flex; flex-direction: column; gap: 8px; margin-top: auto;">
                                        <% if (evt.isStreamedByClubFurn && !isEnded) { %>
                                            <%
                                                const twitchUrl = streamUrlsObj.twitch || 'https://twitch.tv/clubfurn';
                                                const youtubeUrl = streamUrlsObj.youtube || 'https://youtube.com/@clubfurn';
                                                const tiktokUrl = streamUrlsObj.tiktok || null;
                                                const otherUrl = streamUrlsObj.other || null;
                                            %>
                                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px;">
                                                <% if (twitchUrl) { %>
                                                    <a href="<%= twitchUrl %>" target="_blank" class="btn-cc btn-small" style="text-decoration: none; text-align: center; background: rgba(168,85,247,0.2); border: 1px solid #a855f7; color: #a855f7; font-weight: bold; padding: 6px 10px;">
                                                        📺 Twitch ↗
                                                    </a>
                                                <% } %>
                                                <% if (youtubeUrl) { %>
                                                    <a href="<%= youtubeUrl %>" target="_blank" class="btn-cc btn-small" style="text-decoration: none; text-align: center; background: rgba(255,0,0,0.2); border: 1px solid #ff0000; color: #ff0000; font-weight: bold; padding: 6px 10px;">
                                                        🔴 YouTube ↗
                                                    </a>
                                                <% } %>
                                                <% if (tiktokUrl) { %>
                                                    <a href="<%= tiktokUrl %>" target="_blank" class="btn-cc btn-small" style="text-decoration: none; text-align: center; background: rgba(0,242,254,0.2); border: 1px solid #00f2fe; color: #00f2fe; font-weight: bold; padding: 6px 10px;">
                                                        🎵 TikTok ↗
                                                    </a>
                                                <% } %>
                                                <% if (otherUrl) { %>
                                                    <a href="<%= otherUrl %>" target="_blank" class="btn-cc btn-small" style="text-decoration: none; text-align: center; background: rgba(83,252,24,0.2); border: 1px solid #53fc18; color: #53fc18; font-weight: bold; padding: 6px 10px;">
                                                        ⚡ Kick / Live ↗
                                                    </a>
                                                <% } %>
                                            </div>
                                        <% } %>

                                        <% if (evt.eventUrl && !isEnded) { %>
                                            <a href="<%= evt.eventUrl %>" target="_blank" class="btn-cc btn-small <%= isLive ? 'btn-primary' : 'btn-secondary' %>" style="text-decoration: none; width: 100%; box-sizing: border-box; text-align: center; font-weight: bold;">
                                                <%= isLive ? '🌐 Join VRChat Instance ↗' : 'Event Link ↗' %>
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div style="text-align: center; padding: 40px 20px; background: rgba(0,0,0,0.2); border-radius: 14px; border: 1px dashed rgba(255,255,255,0.1);">
                        <h4 style="margin: 0 0 5px 0; color: #fff;">No Partner Events Currently Listed</h4>
                        <p style="margin: 0; font-size: 0.85rem; color: #888;">
                            Check back soon for upcoming events, DJ lineups, and special sessions hosted by <%= partner.name %>.
                        </p>
                    </div>
                <% } %>
            </div>
        </div>

    </div>

    <!-- FLYER LIGHTBOX MODAL -->
    <div id="flyer-lightbox" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.92); z-index: 99999; align-items: center; justify-content: center; backdrop-filter: blur(10px); padding: 20px;" onclick="closeFlyerLightbox()">
        <button type="button" style="position: absolute; top: 20px; right: 25px; background: none; border: none; color: #fff; font-size: 2.5rem; cursor: pointer; z-index: 100000; text-shadow: 0 2px 10px rgba(0,0,0,0.8);" onclick="closeFlyerLightbox()">&times;</button>
        <div style="max-width: 90vw; max-height: 90vh; position: relative; display: flex; flex-direction: column; align-items: center;" onclick="event.stopPropagation()">
            <img id="lightbox-img" src="" alt="Enlarged Event Flyer" style="max-width: 90vw; max-height: 82vh; object-fit: contain; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.9); border: 1px solid rgba(255,255,255,0.15);">
            <p id="lightbox-caption" style="color: #fff; margin-top: 12px; font-size: 1rem; font-weight: bold; text-shadow: 0 2px 8px rgba(0,0,0,0.8); text-align: center; margin-bottom: 0;"></p>
        </div>
    </div>

    <script>
        function openFlyerLightbox(url, title) {
            document.getElementById('lightbox-img').src = url;
            document.getElementById('lightbox-caption').innerText = title || '';
            document.getElementById('flyer-lightbox').style.display = 'flex';
        }
        function closeFlyerLightbox() {
            document.getElementById('flyer-lightbox').style.display = 'none';
        }
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeFlyerLightbox();
        });
    </script>

    <script src="/cdn/js/theme-engine.js"></script>
</body>
</html>
